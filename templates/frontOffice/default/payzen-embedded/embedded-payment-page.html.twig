{% extends 'checkout-base.html.twig' %}


{% block title %}
    {{ 'Payment'|trans }}
{% endblock %}

{# The theme draws the checkout steps, this page being the payment one. #}
{% set current = 3 %}

{% block checkoutSummary %}{% endblock %}

{% block checkoutContent %}
    <div class="flex flex-col items-center justify-center text-center">
        {% if success %}
            <div id="payzen-embedded-payment-form" class="flex justify-center w-full">
                {% include smart_form|default(false)
                    ? 'payzen-embedded/_smart-form.html.twig'
                    : 'payzen-embedded/_card-form.html.twig' %}
            </div>

            <div class="mt-6">
                <a href="{{ path('payzen_embedded_front_abort_payment', {orderId: order_id}) }}" class="button">
                    {{ 'Cancel payment'|trans }}
                </a>
            </div>
        {% else %}
            <div class="flex flex-col items-center justify-center">
                <div class="lg:w-[250px] mb-6">
                    {{ source('assets/images/not-found.svg', true) }}
                </div>
                <h3 class="mt-4 mb-4 h4">{{ 'We\'re sorry, the payment form could not be displayed.'|trans }}</h3>

                {% if errorCode is defined and errorCode %}
                    <div class="mb-6 text-sm text-gray-600">
                        <p><strong>{{ 'Error code'|trans }}:</strong> {{ errorCode }}{% if detailedErrorCode is defined and detailedErrorCode %} ({{ detailedErrorCode }}){% endif %}</p>
                        <p><strong>{{ 'Error message'|trans }}:</strong> {{ errorMessage }}{% if detailedErrorMessage is defined and detailedErrorMessage %} ({{ detailedErrorMessage }}){% endif %}</p>
                    </div>
                {% endif %}

                <a href="{{ path('payzen_embedded_front_abort_payment', {orderId: order_id}) }}" class="button">
                    {{ 'Try again your payment'|trans }}
                </a>

                <p class="mt-4 text-sm">
                    {{ 'You may also <a href="%url">contact us</a> to get help or more information.'|trans|replace({'%url': path('contact')}) | raw }}
                </p>
            </div>
        {% endif %}
    </div>
{% endblock %}

{# The Krypton client and its theme come from the platform the shop is configured on, and the
   SmartForm only works with the neon theme. #}
{% set krypton_base_url = static_base_url|default('https://api.payzen.eu/static/js/krypton-client/V4.0') %}
{% set krypton_theme = smart_form|default(false) ? 'neon' : 'classic' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ krypton_base_url }}/ext/{{ krypton_theme == 'neon' ? 'neon-reset.css' : 'classic.css' }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript"
            src="{{ krypton_base_url }}/stable/kr-payment-form.min.js"
            kr-public-key="{{ public_key }}"
            kr-post-url-success="{{ url('checkout_confirm', {order_id: order_id}) }}"
            kr-post-url-refused="{{ url('payzen_embedded_front_abort_payment', {orderId: order_id}) }}"
            {# The client expects a dash separated locale: fr_FR would silently fall back to English. #}
            kr-language="{{ app.request.locale|replace({'_': '-'}) }}">
    </script>
    <script type="text/javascript" src="{{ krypton_base_url }}/ext/{{ krypton_theme }}.js"></script>
{% endblock %}
