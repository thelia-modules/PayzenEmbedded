{# Credit card form: the customer types the card details in the fields hosted by the platform.
   This form never offers the wallets, see _smart-form.html.twig for those. #}
<div class="kr-embedded" kr-form-token="{{ form_token }}">
    <div class="kr-pan"></div>
    <div class="kr-expiry"></div>
    <div class="kr-security-code"></div>

    <button class="kr-payment-button"></button>

    <div class="kr-form-error"></div>
</div>
