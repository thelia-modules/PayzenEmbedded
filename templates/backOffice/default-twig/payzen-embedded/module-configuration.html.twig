{% set _d = 'payzenembedded.bo.default' %}
<div class="card mb-3">
    <div class="card-header">
        <h2 class="card-title h5 mb-0">{{ 'PayZen Configuration'|trans({}, _d) }}</h2>
    </div>
    <div class="card-body">
        {{ form_start(form, {'action': path('payzen_embedded_configure'), 'method': 'post', 'attr': {'class': 'payzen-embedded-config-form'}}) }}
            {{ form_errors(form) }}

            <div class="row">
                <div class="col-md-4">
                    <p class="h6">{{ 'Access to PayZen Platform'|trans({}, _d) }}</p>

                    <div class="mb-3">
                        {{ form_label(form.site_id) }}
                        {{ form_widget(form.site_id, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.site_id) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.webservice_endpoint) }}
                        {{ form_widget(form.webservice_endpoint, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.webservice_endpoint) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.mode) }}
                        {{ form_widget(form.mode, {attr: {class: 'form-select'}}) }}
                        {{ form_errors(form.mode) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.allowed_ip_list) }}
                        {{ form_widget(form.allowed_ip_list, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.allowed_ip_list) }}
                    </div>

                    <div class="mb-3">
                        <label class="form-label">{{ 'Return URL in the back-office'|trans({}, _d) }}</label>
                        <div class="card card-body bg-light p-2">{{ ipn_callback_url }}</div>
                        <span class="form-text">
                            {{ "Copy this URL in the 'URL to notify in TEST mode' and 'URL to notify in PRODUCTION mode' (which must not be mistaken with the 'Return URL of the shop') in 'Notification rules' fields in the PayZen back-office"|trans({}, _d) }}
                        </span>
                    </div>
                </div>

                <div class="col-md-4">
                    <p class="h6">{{ 'Test parameters'|trans({}, _d) }}</p>

                    <div class="mb-3">
                        {{ form_label(form.test_password) }}
                        {{ form_widget(form.test_password, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.test_password) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.javascript_test_key) }}
                        {{ form_widget(form.javascript_test_key, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.javascript_test_key) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.signature_test_key) }}
                        {{ form_widget(form.signature_test_key, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.signature_test_key) }}
                    </div>

                    <p class="h6">{{ 'Production parameters'|trans({}, _d) }}</p>

                    <div class="mb-3">
                        {{ form_label(form.production_password) }}
                        {{ form_widget(form.production_password, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.production_password) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.javascript_production_key) }}
                        {{ form_widget(form.javascript_production_key, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.javascript_production_key) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.signature_production_key) }}
                        {{ form_widget(form.signature_production_key, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.signature_production_key) }}
                    </div>
                </div>

                <div class="col-md-4">
                    <p class="h6">{{ 'Payment configuration'|trans({}, _d) }}</p>

                    <div class="mb-3">
                        {{ form_label(form.form_type) }}
                        {{ form_widget(form.form_type, {attr: {class: 'form-select'}}) }}
                        {{ form_errors(form.form_type) }}
                    </div>

                    <div class="mb-3 form-check">
                        {{ form_widget(form.smart_form_card_form_expanded, {attr: {class: 'form-check-input'}}) }}
                        {{ form_label(form.smart_form_card_form_expanded, null, {label_attr: {class: 'form-check-label'}}) }}
                        {{ form_errors(form.smart_form_card_form_expanded) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.excluded_payment_methods) }}
                        {{ form_widget(form.excluded_payment_methods) }}
                        {{ form_errors(form.excluded_payment_methods) }}
                    </div>

                    <div class="mb-3 form-check">
                        {{ form_widget(form.popup_mode, {attr: {class: 'form-check-input'}}) }}
                        {{ form_label(form.popup_mode, null, {label_attr: {class: 'form-check-label'}}) }}
                        {{ form_errors(form.popup_mode) }}
                    </div>

                    <div class="mb-3 form-check">
                        {{ form_widget(form.allow_one_click_payments, {attr: {class: 'form-check-input'}}) }}
                        {{ form_label(form.allow_one_click_payments, null, {label_attr: {class: 'form-check-label'}}) }}
                        {{ form_errors(form.allow_one_click_payments) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.payment_source) }}
                        {{ form_widget(form.payment_source, {attr: {class: 'form-select'}}) }}
                        {{ form_errors(form.payment_source) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.capture_delay) }}
                        {{ form_widget(form.capture_delay, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.capture_delay) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.validation_mode) }}
                        {{ form_widget(form.validation_mode, {attr: {class: 'form-select'}}) }}
                        {{ form_errors(form.validation_mode) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.strong_authentication) }}
                        {{ form_widget(form.strong_authentication, {attr: {class: 'form-select'}}) }}
                        {{ form_errors(form.strong_authentication) }}
                    </div>

                    <p class="h6">{{ 'One time payment'|trans({}, _d) }}</p>

                    <div class="mb-3">
                        {{ form_label(form.minimum_amount) }}
                        <div class="input-group">
                            {{ form_widget(form.minimum_amount, {'attr': {'class': 'form-control' ~ (form.minimum_amount.vars.errors|length ? ' is-invalid' : '')}}) }}
                            <span class="input-group-text">{{ default_currency_symbol }}</span>
                        </div>
                        {{ form_errors(form.minimum_amount) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.maximum_amount) }}
                        <div class="input-group">
                            {{ form_widget(form.maximum_amount, {'attr': {'class': 'form-control' ~ (form.maximum_amount.vars.errors|length ? ' is-invalid' : '')}}) }}
                            <span class="input-group-text">{{ default_currency_symbol }}</span>
                        </div>
                        {{ form_errors(form.maximum_amount) }}
                    </div>

                    <p class="h6">{{ 'Email configuration'|trans({}, _d) }}</p>

                    <div class="mb-3 form-check">
                        {{ form_widget(form.send_confirmation_message_only_if_paid, {attr: {class: 'form-check-input'}}) }}
                        {{ form_label(form.send_confirmation_message_only_if_paid, null, {label_attr: {class: 'form-check-label'}}) }}
                        {{ form_errors(form.send_confirmation_message_only_if_paid) }}
                    </div>

                    <div class="mb-3 form-check">
                        {{ form_widget(form.send_payment_confirmation_message, {attr: {class: 'form-check-input'}}) }}
                        {{ form_label(form.send_payment_confirmation_message, null, {label_attr: {class: 'form-check-label'}}) }}
                        {{ form_errors(form.send_payment_confirmation_message) }}
                    </div>

                    {% if payment_confirmation_message_id %}
                        <div class="card card-body bg-light p-2">
                            <span><i class="bi bi-info-circle"></i></span>
                            {{ 'You can edit the payment confirmation email sent to the customer after a successful payment.'|trans({}, _d) }}
                            <a href="{{ path('admin.configuration.messages.update', {'message_id': payment_confirmation_message_id}) }}">{{ 'Edit'|trans({}, _d) }}</a>
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="text-end mt-3">
                <a href="{{ path('admin.module') }}" class="btn btn-secondary">{{ 'Cancel'|trans({}, _d) }}</a>
                <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> {{ 'Save'|trans({}, _d) }}</button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
