# Sale unit symbols of a core newer than the published one, used behind PayzenEmbedded::supportsSaleUnits().
# Kept out of the report so that PHPStan runs against the published core; an entry the core catches up with is not reported.
parameters:
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            message: '#^Call to static method runFor\(\) on an unknown class Thelia\\Domain\\SaleUnit\\Config\\SaleUnitConfigScope\.$#'
            count: 2
            path: PayzenEmbedded.php
        -
            message: '#^Parameter \$adminSaleUnitScope of method PayzenEmbedded\\Service\\SaleUnitContractSettings::__construct\(\) has invalid type Thelia\\Domain\\SaleUnit\\Access\\AdminSaleUnitScope\.$#'
            count: 1
            path: Service/SaleUnitContractSettings.php
        -
            message: '#^Property PayzenEmbedded\\Service\\SaleUnitContractSettings::\$adminSaleUnitScope has unknown class Thelia\\Domain\\SaleUnit\\Access\\AdminSaleUnitScope as its type\.$#'
            count: 1
            path: Service/SaleUnitContractSettings.php
        -
            message: '#^Call to static method create\(\) on an unknown class Thelia\\Model\\SaleUnitQuery\.$#'
            count: 2
            path: Service/SaleUnitContractSettings.php
        -
            message: '#^Call to an undefined static method PayzenEmbedded\\PayzenEmbedded::(deleteConfigValueForSaleUnit|setConfigValueForSaleUnit)\(\)\.$#'
            count: 3
            path: Service/SaleUnitContractSettings.php
        # Stored payment methods and payment parts of a core newer than the published one (Thelia 3.3.0): the
        # module implements the two interfaces and reads the payment methods and the parts through the core's own
        # classes. Every message that names one of these symbols says it is unknown, on a core that predates them.
        # Limited to the files that name them. No count: the published core could not be installed to count them.
        -
            message: '#Thelia\\(Model\\(CustomerPaymentMethod|OrderPaymentPart)(Query)?\b|Domain\\Payment\\|Domain\\SaleUnit\\Config\\SaleUnitConfigScope\b|Api\\Resource\\PaymentModuleStoredMethodOption\b|Module\\(BalanceChargingPaymentModuleInterface|PaymentModuleWithStoredMethodsInterface)\b)#'
            paths:
                - PayzenEmbedded.php
                - EventListener/StoredMethodsOfTheSaleUnitListener.php
                - Controller/FrontController.php
                - Form/TransactionUpdateForm.php
                - Hook/FrontHookManager.php
                - Loop/OneClickPaymentLoop.php
                - LyraClient/LyraJavascriptClientManagementWrapper.php
                - LyraClient/LyraPaymentManagementWrapper.php
                - Service/CardFormProvider.php
                - Service/StoredMethodContract.php
                - Service/StoredMethodOfAnotherContractException.php
                - Service/StoredMethodRecorder.php
                - Service/StoredMethodRevoker.php
        # The refusal of a card of another sale unit extends the core's CustomerPaymentMethodException (Thelia 3.3.0): on a
        # core that predates it the class has no parent, and PHPStan then reports its call to the parent constructor.
        -
            message: '#^PayzenEmbedded\\Service\\StoredMethodOfAnotherContractException::__construct\(\) calls parent::__construct\(\) but PayzenEmbedded\\Service\\StoredMethodOfAnotherContractException does not extend any class\.$#'
            path: Service/StoredMethodOfAnotherContractException.php
