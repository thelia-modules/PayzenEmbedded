<?xml version="1.0" encoding="UTF-8"?>
<!--
    Run from the shop the module is installed in:
        vendor/bin/phpunit -c vendor/thelia/modules/PayzenEmbedded
    or, for a module in local/modules:
        vendor/bin/phpunit -c local/modules/PayzenEmbedded
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="PayzenEmbedded">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
